<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oceania Cetáceos - O Fascinante Reino das Baleias</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ocean: {
                            950: '#020813',
                            900: '#030e21',
                            850: '#061633',
                            800: '#0a192f',
                            700: '#0f2b4a',
                            600: '#17406d',
                            cyan: '#38bdf8',
                            teal: '#2dd4bf',
                            glow: '#00f2fe'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['"Playfair Display"', 'serif'],
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-glow': 'pulseGlow 3s infinite',
                        'wave': 'wave 10s linear infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-12px)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { opacity: '0.4', filter: 'drop-shadow(0 0 15px rgba(56, 189, 248, 0.4))' },
                            '50%': { opacity: '0.9', filter: 'drop-shadow(0 0 30px rgba(45, 212, 191, 0.8))' },
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #030e21;
        }
        ::-webkit-scrollbar-thumb {
            background: #17406d;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #38bdf8;
        }

        /* Glassmorphism Classes */
        .glass-card {
            background: rgba(10, 25, 47, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.15);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glass-nav {
            background: rgba(3, 14, 33, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(56, 189, 248, 0.12);
        }

        .glass-glow {
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.25);
        }

        /* Depth simulator background gradient dynamic */
        .depth-gradient {
            transition: background 0.8s ease;
        }

        /* Custom Wave Divider */
        .wave-divider {
            position: relative;
            width: 100%;
            overflow: hidden;
            line-height: 0;
        }
        .wave-divider svg {
            position: relative;
            display: block;
            width: calc(100% + 1.3px);
            height: 60px;
        }

        /* SVG Hotspot Ripple */
        .hotspot-pulse {
            animation: hotspotPulse 2s infinite;
        }
        @keyframes hotspotPulse {
            0% { r: 6px; opacity: 1; }
            100% { r: 18px; opacity: 0; }
        }
    </style>
</head>
<body class="bg-ocean-950 text-slate-100 font-sans selection:bg-ocean-cyan selection:text-ocean-950 overflow-x-hidden">

    <!-- Navigation Header -->
    <header class="fixed top-0 left-0 w-full z-50 glass-nav transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo -->
            <a href="#" class="flex items-center space-x-3 group">
                <div class="p-2.5 rounded-2xl bg-gradient-to-tr from-ocean-cyan/20 to-ocean-teal/20 border border-ocean-cyan/30 text-ocean-cyan group-hover:scale-105 transition-transform">
                    <svg class="w-7 h-7 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 16c3-2 6-2 9 0s6 2 9 0"></path>
                        <path d="M12 14c-4-4-2-9 3-10 1 3 3 5 7 5 1 2 0 5-2 6-2 1-5 0-8-1z"></path>
                        <circle cx="17" cy="8" r="1" fill="currentColor"></circle>
                    </svg>
                </div>
                <div>
                    <span class="font-serif text-xl sm:text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-slate-100 via-ocean-cyan to-ocean-teal">Oceania</span>
                    <span class="block text-[10px] tracking-widest text-ocean-cyan font-semibold uppercase">Cetáceos</span>
                </div>
            </a>

            <!-- Desktop Menu -->
            <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium">
                <a href="#especies" class="hover:text-ocean-cyan transition-colors py-1">Espécies</a>
                <a href="#comparador" class="hover:text-ocean-cyan transition-colors py-1">Comparador</a>
                <a href="#profundidade" class="hover:text-ocean-cyan transition-colors py-1">Profundidade</a>
                <a href="#anatomia" class="hover:text-ocean-cyan transition-colors py-1">Anatomia</a>
                <a href="#sintetizador" class="hover:text-ocean-cyan transition-colors py-1">Cantos Synthesizer</a>
                <a href="#migracao" class="hover:text-ocean-cyan transition-colors py-1">Migração</a>
                <a href="#quiz" class="hover:text-ocean-cyan transition-colors py-1">Quiz</a>
            </nav>

            <!-- Quick Ambient Audio Toggle Button -->
            <div class="flex items-center space-x-4">
                <button id="global-audio-btn" onclick="toggleGlobalAmbient()" class="flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-ocean-800/80 hover:bg-ocean-700 border border-ocean-cyan/30 text-xs text-ocean-cyan transition-all hover:shadow-[0_0_15px_rgba(56,189,248,0.3)]">
                    <i data-lucide="volume-2" id="global-audio-icon" class="w-4 h-4"></i>
                    <span id="global-audio-text" class="hidden sm:inline">Som do Oceano</span>
                </button>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn" onclick="toggleMobileMenu()" class="lg:hidden p-2 rounded-lg bg-ocean-800 border border-ocean-cyan/20 text-slate-200">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Nav Menu Panel -->
        <div id="mobile-menu" class="hidden lg:hidden border-b border-ocean-cyan/10 bg-ocean-900/95 backdrop-blur-xl px-6 py-6 space-y-4">
            <a href="#especies" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2 border-b border-ocean-800">Espécies</a>
            <a href="#comparador" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2 border-b border-ocean-800">Comparador de Tamanho</a>
            <a href="#profundidade" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2 border-b border-ocean-800">Simulador de Profundidade</a>
            <a href="#anatomia" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2 border-b border-ocean-800">Anatomia Interativa</a>
            <a href="#sintetizador" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2 border-b border-ocean-800">Sintetizador de Cantos</a>
            <a href="#migracao" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2 border-b border-ocean-800">Rotas Migratórias</a>
            <a href="#quiz" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-ocean-cyan py-2">Quiz Ecológico</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative min-h-screen pt-28 pb-16 flex items-center justify-center overflow-hidden">
        <!-- Interactive Particle Canvas Background -->
        <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>
        
        <!-- Glowing Ambient Lighting -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 sm:w-[600px] h-96 sm:h-[600px] bg-ocean-cyan/10 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute bottom-10 left-10 w-80 h-80 bg-ocean-teal/10 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
            <!-- Badge -->
            <div class="inline-flex items-center space-x-2 px-4 py-2 rounded-full glass-card border border-ocean-cyan/30 text-ocean-cyan text-xs sm:text-sm font-semibold mb-8 animate-float">
                <i data-lucide="waves" class="w-4 h-4"></i>
                <span>Exploração Marinha Profunda & Interativa</span>
            </div>

            <!-- Title -->
            <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-slate-100 leading-[1.15] mb-6">
                O Fascinante Reino dos <br class="hidden sm:inline">
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-ocean-cyan via-teal-300 to-indigo-400">Leviatãs dos Oceanos</span>
            </h1>

            <p class="max-w-2xl mx-auto text-base sm:text-xl text-slate-300 font-light leading-relaxed mb-10">
                Mergulhe no universo dos cetáceos. Descubra espécies majestosas, ouça cantos sintetizados em tempo real, explore abismos de +3.000 metros e compare a anatomia dos gigantes do mar.
            </p>

            <!-- Call To Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
                <a href="#especies" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-ocean-cyan to-ocean-teal text-ocean-950 font-bold text-base hover:shadow-[0_0_30px_rgba(56,189,248,0.5)] transition-all transform hover:-translate-y-0.5 flex items-center justify-center space-x-2">
                    <span>Iniciar Mergulho Virtual</span>
                    <i data-lucide="arrow-down" class="w-5 h-5"></i>
                </a>
                <a href="#sintetizador" class="w-full sm:w-auto px-8 py-4 rounded-2xl glass-card text-slate-100 font-semibold text-base hover:bg-ocean-800/80 border border-ocean-cyan/30 transition-all flex items-center justify-center space-x-2">
                    <i data-lucide="music" class="w-5 h-5 text-ocean-cyan"></i>
                    <span>Ouvir Cantos Sintetizados</span>
                </a>
            </div>

            <!-- Animated Stat Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                <div class="glass-card p-5 rounded-2xl text-center border-t-2 border-t-ocean-cyan">
                    <div class="text-3xl sm:text-4xl font-extrabold text-ocean-cyan mb-1 counter" data-target="90">+0</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium">Espécies Conhecidas</div>
                </div>
                <div class="glass-card p-5 rounded-2xl text-center border-t-2 border-t-ocean-teal">
                    <div class="text-3xl sm:text-4xl font-extrabold text-ocean-teal mb-1"><span class="counter" data-target="30">0</span>m</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium">Comprimento Máximo</div>
                </div>
                <div class="glass-card p-5 rounded-2xl text-center border-t-2 border-t-indigo-400">
                    <div class="text-3xl sm:text-4xl font-extrabold text-indigo-400 mb-1"><span class="counter" data-target="200">0</span>t</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium">Peso Recorde (Azul)</div>
                </div>
                <div class="glass-card p-5 rounded-2xl text-center border-t-2 border-t-emerald-400">
                    <div class="text-3xl sm:text-4xl font-extrabold text-emerald-400 mb-1">+<span class="counter" data-target="3000">0</span>m</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium">Profundidade de Mergulho</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Wave Divider -->
    <div class="wave-divider text-ocean-900">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="currentColor"></path>
        </svg>
    </div>

    <!-- Interactive Species Encyclopedia -->
    <section id="especies" class="py-20 bg-ocean-900 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 class="text-xs font-bold text-ocean-cyan tracking-widest uppercase mb-3">Catálogo de Espécies</h2>
                <h3 class="font-serif text-3xl sm:text-5xl font-bold text-slate-100 mb-4">Enciclopédia Interativa de Cetáceos</h3>
                <p class="text-slate-400 text-base">Filtre por tipo, pesquise nomes e clique nos cards para visualizar fichas completas, rotas e cantos.</p>
            </div>

            <!-- Search and Filters Bar -->
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10 glass-card p-4 rounded-2xl">
                <!-- Search Input -->
                <div class="relative w-full md:w-80">
                    <i data-lucide="search" class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="species-search" oninput="filterSpecies()" placeholder="Buscar por nome (ex: Jubarte, Orca)..." class="w-full pl-11 pr-4 py-2.5 rounded-xl bg-ocean-950/80 border border-ocean-cyan/20 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-ocean-cyan text-sm">
                </div>

                <!-- Filter Category Buttons -->
                <div class="flex flex-wrap items-center gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0">
                    <button onclick="setFilter('todos')" class="filter-btn active px-4 py-2 rounded-xl text-xs font-semibold bg-ocean-cyan text-ocean-950 transition-all">Todos</button>
                    <button onclick="setFilter('misticeto')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold glass-card hover:border-ocean-cyan/50 text-slate-300 transition-all">Misticetos (Barreiras)</button>
                    <button onclick="setFilter('odontoceto')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold glass-card hover:border-ocean-cyan/50 text-slate-300 transition-all">Odontocetos (Dentes)</button>
                    <button onclick="setFilter('ameacada')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold glass-card hover:border-ocean-cyan/50 text-slate-300 transition-all">Ameaçadas</button>
                    <button onclick="setFilter('brasil')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold glass-card hover:border-ocean-cyan/50 text-slate-300 transition-all">Visitantes do Brasil 🇧🇷</button>
                </div>
            </div>

            <!-- Species Grid -->
            <div id="species-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Injected via JavaScript -->
            </div>
        </div>
    </section>

    <!-- Species Detail Modal -->
    <div id="species-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-ocean-950/80 backdrop-blur-md overflow-y-auto">
        <div class="relative w-full max-w-3xl glass-card rounded-3xl overflow-hidden border border-ocean-cyan/30 max-h-[90vh] flex flex-col my-auto shadow-2xl">
            <!-- Modal Header Image -->
            <div class="relative h-64 sm:h-80 w-full overflow-hidden">
                <img id="modal-img" src="" alt="" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-ocean-950 via-ocean-950/40 to-transparent"></div>
                
                <button onclick="closeModal()" class="absolute top-4 right-4 p-2 rounded-full bg-ocean-950/70 border border-white/20 text-slate-200 hover:text-white hover:bg-ocean-800 transition-all">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>

                <div class="absolute bottom-4 left-6 right-6">
                    <span id="modal-status" class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-2 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"></span>
                    <h3 id="modal-title" class="font-serif text-3xl sm:text-4xl font-bold text-white"></h3>
                    <p id="modal-scientific" class="text-ocean-cyan italic text-sm sm:text-base"></p>
                </div>
            </div>

            <!-- Modal Body Content -->
            <div class="p-6 sm:p-8 overflow-y-auto space-y-6">
                <!-- Metrics Bar -->
                <div class="grid grid-cols-3 gap-4 p-4 rounded-2xl bg-ocean-950/60 border border-ocean-cyan/10 text-center">
                    <div>
                        <span class="block text-xs text-slate-400">Comprimento</span>
                        <span id="modal-length" class="text-base sm:text-lg font-bold text-ocean-cyan"></span>
                    </div>
                    <div>
                        <span class="block text-xs text-slate-400">Peso Máximo</span>
                        <span id="modal-weight" class="text-base sm:text-lg font-bold text-ocean-teal"></span>
                    </div>
                    <div>
                        <span class="block text-xs text-slate-400">Profundidade</span>
                        <span id="modal-depth" class="text-base sm:text-lg font-bold text-indigo-400"></span>
                    </div>
                </div>

                <div>
                    <h4 class="text-sm font-bold uppercase tracking-wider text-ocean-cyan mb-2">Visão Geral & Descrição</h4>
                    <p id="modal-desc" class="text-slate-300 text-sm sm:text-base leading-relaxed"></p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="p-4 rounded-2xl bg-ocean-850 border border-ocean-cyan/10">
                        <div class="flex items-center space-x-2 text-ocean-teal font-semibold text-sm mb-2">
                            <i data-lucide="fish" class="w-4 h-4"></i>
                            <span>Alimentação e Dieta</span>
                        </div>
                        <p id="modal-diet" class="text-xs sm:text-sm text-slate-300"></p>
                    </div>

                    <div class="p-4 rounded-2xl bg-ocean-850 border border-ocean-cyan/10">
                        <div class="flex items-center space-x-2 text-ocean-cyan font-semibold text-sm mb-2">
                            <i data-lucide="compass" class="w-4 h-4"></i>
                            <span>Rota & Habitação</span>
                        </div>
                        <p id="modal-habitat" class="text-xs sm:text-sm text-slate-300"></p>
                    </div>
                </div>

                <!-- Interactive Sound Simulation Button inside modal -->
                <div class="p-4 rounded-2xl bg-gradient-to-r from-ocean-800 to-ocean-900 border border-ocean-cyan/30 flex items-center justify-between">
                    <div>
                        <h5 class="font-semibold text-slate-100 text-sm">Ouvir Vocalização Simulação</h5>
                        <p class="text-xs text-slate-400">Sintetizador acústico subaquático em tempo real</p>
                    </div>
                    <button id="modal-sound-btn" onclick="playModalSound()" class="px-4 py-2 rounded-xl bg-ocean-cyan hover:bg-ocean-teal text-ocean-950 font-bold text-xs flex items-center space-x-2 transition-all">
                        <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                        <span>Reproduzir Canto</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Size & Weight Comparator -->
    <section id="comparador" class="py-20 bg-ocean-950 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-14">
                <h2 class="text-xs font-bold text-ocean-teal tracking-widest uppercase mb-3">Escala Visual</h2>
                <h3 class="font-serif text-3xl sm:text-5xl font-bold text-slate-100 mb-4">Comparador Visual de Tamanho e Peso</h3>
                <p class="text-slate-400 text-base">Compare a dimensão de grandes cetáceos com elementos do nosso cotidiano, como um ser humano, um ônibus escolar ou um submarino nuclear.</p>
            </div>

            <div class="glass-card p-6 sm:p-10 rounded-3xl border border-ocean-cyan/20">
                <!-- Controls -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                    <div>
                        <label class="block text-xs font-bold text-ocean-cyan uppercase tracking-wider mb-2">1. Selecione o Cetáceo:</label>
                        <select id="comp-whale-select" onchange="updateComparison()" class="w-full px-4 py-3 rounded-xl bg-ocean-900 border border-ocean-cyan/30 text-slate-100 text-sm focus:outline-none focus:border-ocean-cyan">
                            <option value="blue">Baleia-Azul (30m / 190t)</option>
                            <option value="fin">Baleia-Fin (24m / 80t)</option>
                            <option value="sperm">Cachalote (18m / 50t)</option>
                            <option value="humpback">Baleia-Jubarte (16m / 36t)</option>
                            <option value="orca">Orca (9m / 6t)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-ocean-teal uppercase tracking-wider mb-2">2. Comparar com Referência:</label>
                        <select id="comp-ref-select" onchange="updateComparison()" class="w-full px-4 py-3 rounded-xl bg-ocean-900 border border-ocean-cyan/30 text-slate-100 text-sm focus:outline-none focus:border-ocean-teal">
                            <option value="human">Ser Humano (1.8m / 0.08t)</option>
                            <option value="elephant">Elefante Africano (4m / 6t)</option>
                            <option value="bus">Ônibus Escolar (12m / 12t)</option>
                            <option value="submarine">Submarino de Pesquisa (70m / 1000t)</option>
                        </select>
                    </div>
                </div>

                <!-- Visual Bar Chart Comparison Display -->
                <div class="space-y-8 my-8">
                    <!-- Whale Item Bar -->
                    <div>
                        <div class="flex justify-between text-sm font-semibold mb-2">
                            <span id="comp-whale-label" class="text-ocean-cyan flex items-center space-x-2">
                                <i data-lucide="fish" class="w-4 h-4"></i>
                                <span>Baleia-Azul</span>
                            </span>
                            <span id="comp-whale-metrics" class="text-slate-300">30 metros | 190 toneladas</span>
                        </div>
                        <div class="w-full h-10 bg-ocean-900/80 rounded-xl p-1 border border-ocean-cyan/20 relative overflow-hidden">
                            <div id="comp-whale-bar" class="h-full bg-gradient-to-r from-ocean-cyan to-ocean-teal rounded-lg transition-all duration-700 flex items-center justify-end pr-3 text-ocean-950 font-bold text-xs" style="width: 100%;">
