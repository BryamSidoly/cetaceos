        function updateDepthSimulator() {
            const depth = parseInt(document.getElementById('depth-range').value);
            document.getElementById('depth-value').textContent = `${depth} metros`;

            const container = document.getElementById('depth-container');
            const zoneTitle = document.getElementById('zone-title');
            const zoneDesc = document.getElementById('zone-desc');
            const zonePressure = document.getElementById('zone-pressure');
            const zoneTemp = document.getElementById('zone-temp');
            const speciesList = document.getElementById('depth-species-list');

            // Calculate Pressure & Temp
            const pressure = (1 + (depth / 10)).toFixed(1);
            let temp = (22 - (depth / 150)).toFixed(1);
            if (temp < 2) temp = "2.0";

            zonePressure.textContent = `${pressure} atm`;
            zoneTemp.textContent = `${temp} °C`;

            // Calculate Ocean Zones and color gradients
            if (depth <= 200) {
                container.style.background = 'linear-gradient(180deg, #0f2b4a 0%, #081a36 100%)';
                zoneTitle.textContent = 'Zona Epipelágica (0 - 200m)';
                zoneDesc.textContent = 'Zona de luz solar abundante. Alta biodiversidade, plâncton em suspensão e baleias em superfície.';
            } else if (depth <= 1000) {
                container.style.background = 'linear-gradient(180deg, #081a36 0%, #040e21 100%)';
                zoneTitle.textContent = 'Zona Mesopelágica (200 - 1000m)';
                zoneDesc.textContent = 'Zona da penumbra. A luz solar diminui drasticamente. Início da bioluminescência.';
            } else {
                container.style.background = 'linear-gradient(180deg, #040e21 0%, #01040a 100%)';
