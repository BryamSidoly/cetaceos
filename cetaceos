            const visualizerCtx = visualizerCanvas.getContext('2d');
            visualizerCanvas.width = visualizerCanvas.offsetWidth;
            visualizerCanvas.height = visualizerCanvas.offsetHeight;

            const masterGain = audioCtx.createGain();
            masterGain.gain.setValueAtTime(0.3, audioCtx.currentTime);

            const analyser = audioCtx.createAnalyser();
            analyser.fftSize = 64;
            masterGain.connect(analyser);
            analyser.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (preset === 'humpback') {
                // Jubarte: Frequency sweeps
                const osc = audioCtx.createOscillator();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.exponentialRampToValueAtTime(700, now + 1.5);
                osc.frequency.exponentialRampToValueAtTime(200, now + 3.0);

                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(0, now);
                gain.gain.linearRampToValueAtTime(0.5, now + 0.5);
                gain.gain.linearRampToValueAtTime(0, now + 3.0);

                osc.connect(gain);
                gain.connect(masterGain);
                osc.start(now);
                osc.stop(now + 3.0);
                activeOscillators.push(osc);

            } else if (preset === 'blue') {
                // Blue whale deep infra-bass
                const osc = audioCtx.createOscillator();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(45, now);
                osc.frequency.linearRampToValueAtTime(35, now + 4.0);

                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(0, now);
                gain.gain.linearRampToValueAtTime(0.8, now + 1.0);
                gain.gain.linearRampToValueAtTime(0, now + 4.0);

                osc.connect(gain);
                gain.connect(masterGain);
                osc.start(now);
                osc.stop(now + 4.0);
                activeOscillators.push(osc);

            } else if (preset === 'sperm') {
                // Cachalote click sequence
                for (let i = 0; i < 8; i++) {
                    const clickTime = now + (i * 0.25);
                    const osc = audioCtx.createOscillator();
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(1200, clickTime);

                    const gain = audioCtx.createGain();
                    gain.gain.setValueAtTime(0.6, clickTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, clickTime + 0.05);

                    osc.connect(gain);
                    gain.connect(masterGain);
                    osc.start(clickTime);
                    osc.stop(clickTime + 0.05);
                    activeOscillators.push(osc);
                }
            } else if (preset === 'abyss') {
                // Deep Ocean Noise Rumble
                const bufferSize = audioCtx.sampleRate * 3;
                const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                const output = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    output[i] = Math.random() * 2 - 1;
                }

                const whiteNoise = audioCtx.createBufferSource();
                whiteNoise.buffer = buffer;

                const filter = audioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(120, now);

                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(0.7, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 3.0);

                whiteNoise.connect(filter);
                filter.connect(gain);
                gain.connect(masterGain);
                whiteNoise.start(now);
                whiteNoise.stop(now + 3.0);
            }

            // Animate Visualizer Waveform
            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            function drawWaveform() {
                if (activeOscillators.length === 0 && preset !== 'sperm') return;
                requestAnimationFrame(drawWaveform);
                analyser.getByteFrequencyData(dataArray);

                visualizerCtx.clearRect(0, 0, visualizerCanvas.width, visualizerCanvas.height);
                const barWidth = (visualizerCanvas.width / bufferLength) * 2.5;
                let x = 0;

                for (let i = 0; i < bufferLength; i++) {
                    const barHeight = (dataArray[i] / 255) * visualizerCanvas.height;
                    visualizerCtx.fillStyle = '#38bdf8';
                    visualizerCtx.fillRect(x, visualizerCanvas.height - barHeight, barWidth, barHeight);
                    x += barWidth + 2;
                }
            }
            drawWaveform();
        }

        function playModalSound() {
            if (activeModalSpecies) {
                if (activeModalSpecies.id === 'sperm') playSynthPreset('sperm');
                else if (activeModalSpecies.id === 'blue') playSynthPreset('blue');
                else playSynthPreset('humpback');
            }
        }

        let ambientActive = false;
        let ambientSource = null;

        function toggleGlobalAmbient() {
            initAudioContext();
            const btnText = document.getElementById('global-audio-text');
            const btnIcon = document.getElementById('global-audio-icon');

            if (!ambientActive) {
                ambientActive = true;
                btnText.textContent = "Som Ativo";
                playSynthPreset('humpback');
            } else {
                ambientActive = false;
                btnText.textContent = "Som do Oceano";
                stopSynthSound();
            }
        }

        function setSeason(season) {
            const path = document.getElementById('migration-path-1');
            const title = document.getElementById('season-info-title');
            const desc = document.getElementById('season-info-desc');

            const btnWinter = document.getElementById('season-winter');
            const btnSummer = document.getElementById('season-summer');

            if (season === 'inverno') {
                btnWinter.className = "px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-ocean-cyan text-ocean-950";
                btnSummer.className = "px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-300 hover:text-white transition-all";
                title.textContent = "Época de Inverno (Junho a Novembro)";
                desc.textContent = "Milhares de Baleias-Jubarte viajam mais de 4.000 km do gelo Antártico até as águas calmas e quentes do Parque Nacional Marinho dos Abrolhos na Bahia para acasalar e amamentar seus filhotes.";
                path.setAttribute('d', 'M 500 470 Q 420 420 360 345');
            } else {
                btnSummer.className = "px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-ocean-cyan text-ocean-950";
                btnWinter.className = "px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-300 hover:text-white transition-all";
                title.textContent = "Época de Verão (Dezembro a Maio)";
                desc.textContent = "As baleias retornam para o Oceano Antártico gelado, rico em krill e nutrientes, onde se alimentam continuamente para acumular gordura suficiente para o ano seguinte.";
                path.setAttribute('d', 'M 360 345 Q 420 420 500 470');
            }
        }

        const quizData = [
            {
                q: 'Qual é o maior animal que já existiu no planeta Terra?',
                options: ['Megalodonte', 'Baleia-Azul', 'Dreadnoughtus (Dissauro)', 'Cachalote'],
                correct: 1,
                explanation: 'A Baleia-Azul é o maior animal de todos os tempos, atingindo até 30 metros de comprimento e 190 toneladas.'
            },
            {
                q: 'Qual espécie de baleia é mundialmente famosa pelos seus saltos acrobáticos na costa brasileira?',
                options: ['Baleia-Jubarte', 'Baleia-Fin', 'Baleia-Cinzenta', 'Baleia-Minke'],
                correct: 0,
                explanation: 'A Baleia-Jubarte visita a costa brasileira (como Abrolhos-BA) no inverno para reprodução e exibe saltos incríveis.'
            },
            {
                q: 'Como o Cachalote caça em profundidades extremas de até 3.000 metros na escuridão total?',
                options: ['Usando visão noturna bioluminescente', 'Através de ecolocalização com cliques de som', 'Pelo olfato apurado', 'Seguindo correntes térmicas'],
                correct: 1,
                explanation: 'Os Cachalotes usam um sistema avançado de ecolocalização emitindo cliques ultrassônicos para mapear e localizar lulas gigantes na escuridão abissal.'
            },
            {
                q: 'O que são as "barretas" (ou barbas) presentes em baleias como a Baleia-Azul e Jubarte?',
                options: ['Dentes afiados para mastigar peixes', 'Placas de queratina usadas para filtrar alimento', 'Ossos da nadadeira peitoral', 'Sensores térmicos de pele'],
                correct: 1,
                explanation: 'As barretas são feitas de queratina (mesmo material de nossas unhas) e servem para filtrar krill e água.'
            },
            {
                q: 'Qual é uma das maiores ameaças atuais enfrentadas pelas baleias no mundo moderno?',
                options: ['Poluição por plásticos e redes de pesca fantasma', 'Colisão com navios cargueiros', 'Poluição sonora marinha por motores', 'Todas as alternativas anteriores'],
                correct: 3,
                explanation: 'Todas as alternativas são ameaças graves geradas pela atividade humana nos oceanos que exigem preservação imediata.'
            }
        ];

        let currentQuizIndex = 0;
        let quizScore = 0;

        function loadQuestion() {
            const q = quizData[currentQuizIndex];
            document.getElementById('quiz-step').textContent = `Pergunta ${currentQuizIndex + 1} de ${quizData.length}`;
            document.getElementById('quiz-question').textContent = q.q;
            document.getElementById('quiz-progress').style.width = `${((currentQuizIndex + 1) / quizData.length) * 100}%`;

            const optionsBox = document.getElementById('quiz-options');
            optionsBox.innerHTML = '';

            const feedback = document.getElementById('quiz-feedback');
            feedback.className = 'hidden p-4 rounded-xl text-xs sm:text-sm mb-6';

            document.getElementById('quiz-next-btn').classList.add('hidden');

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'w-full p-4 rounded-2xl glass-card text-left text-xs sm:text-sm font-semibold hover:border-ocean-cyan/50 transition-all flex items-center justify-between text-slate-200';
                btn.innerHTML = `<span>${opt}</span> <i data-lucide="circle" class="w-4 h-4 text-slate-500"></i>`;
                btn.onclick = () => checkAnswer(idx, btn);
                optionsBox.appendChild(btn);
            });
            lucide.createIcons();
        }

        function checkAnswer(selectedIdx, button) {
            const q = quizData[currentQuizIndex];
            const feedback = document.getElementById('quiz-feedback');
            const allBtns = document.getElementById('quiz-options').children;

            for (let btn of allBtns) {
                btn.disabled = true;
            }

            if (selectedIdx === q.correct) {
                quizScore++;
                button.classList.add('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-300');
                feedback.className = 'p-4 rounded-xl text-xs sm:text-sm mb-6 bg-emerald-500/10 border border-emerald-500/30 text-emerald-300';
                feedback.innerHTML = `<strong>Correto!</strong> ${q.explanation}`;
            } else {
                button.classList.add('bg-red-500/20', 'border-red-500', 'text-red-300');
                allBtns[q.correct].classList.add('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-300');
                feedback.className = 'p-4 rounded-xl text-xs sm:text-sm mb-6 bg-red-500/10 border border-red-500/30 text-red-300';
                feedback.innerHTML = `<strong>Incorreto.</strong> ${q.explanation}`;
            }

            document.getElementById('quiz-next-btn').classList.remove('hidden');
        }

        function nextQuestion() {
            currentQuizIndex++;
            if (currentQuizIndex < quizData.length) {
                loadQuestion();
            } else {
                showQuizResults();
            }
        }

        function showQuizResults() {
            document.getElementById('quiz-question-box').classList.add('hidden');
            document.getElementById('quiz-results').classList.remove('hidden');
            document.getElementById('quiz-final-score').textContent = `${quizScore} / ${quizData.length}`;
        }

        function resetQuiz() {
            currentQuizIndex = 0;
            quizScore = 0;
            document.getElementById('quiz-results').classList.add('hidden');
            document.getElementById('quiz-question-box').classList.remove('hidden');
            loadQuestion();
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function animateCounters() {
            const counters = document.querySelectorAll('.counter');
            counters.forEach(c => {
                const target = +c.getAttribute('data-target');
                let count = 0;
                const speed = target / 50;

                const updateCount = () => {
                    count += speed;
                    if (count < target) {
                        c.innerText = Math.ceil(count);
                        setTimeout(updateCount, 30);
                    } else {
                        c.innerText = target;
                    }
                };
                updateCount();
            });
        }

        window.onload = function() {
            lucide.createIcons();
            renderSpecies();
            updateComparison();
            updateDepthSimulator();
            selectAnatomy('blowhole');
            loadQuestion();
            animateCounters();
        };
    </script>
