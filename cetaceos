            const maxLength = Math.max(whale.lengthNum, ref.length);
            const whalePct = Math.round((whale.lengthNum / maxLength) * 100);
            const refPct = Math.round((ref.length / maxLength) * 100);

            document.getElementById('comp-whale-bar').style.width = `${whalePct}%`;
            document.getElementById('comp-whale-bar').textContent = `${whalePct}%`;

            document.getElementById('comp-ref-bar').style.width = `${refPct}%`;
            document.getElementById('comp-ref-bar').textContent = `${refPct}%`;

            const ratioLength = (whale.lengthNum / ref.length).toFixed(1);
            const ratioWeight = Math.round(whale.weightNum / ref.weight);

            document.getElementById('comp-fact-text').textContent = 
                `A ${whale.name} é aproximadamente ${ratioLength}x mais longa do que um(a) ${ref.name} e seu peso total equivale a cerca de ${ratioWeight} unidades de ${ref.name} juntos!`;

