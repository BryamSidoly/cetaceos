                zoneDesc.textContent = 'Escuridão total, frio congelante e pressão massacrante. Lar de lulas gigantes e cetáceos mergulhadores profundos.';
            }

            // Available species at this depth range
            speciesList.innerHTML = '';
            const matching = speciesData.filter(s => s.maxDepth >= depth);

            if (matching.length === 0) {
                speciesList.innerHTML = '<span class="text-xs text-slate-400 italic">Nenhum cetáceo comum atinge esta profundidade extrema regularmente (Apenas o Cachalote chega até ~3.000m).</span>';
